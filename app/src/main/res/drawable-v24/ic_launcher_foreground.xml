<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Tilted 3D Frosted Glass Pane (Perspective Card) -->
    <path
        android:pathData="M38,30 L70,30 L80,78 L28,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="38"
                android:startY="30"
                android:endX="80"
                android:endY="78"
                android:type="linear">
                <item android:color="#3DFFFFFF" android:offset="0.0" />
                <item android:color="#2064D2FF" android:offset="0.45" />
                <item android:color="#140A84FF" android:offset="0.75" />
                <item android:color="#33BF5AF2" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glass Pane Luminous Rim Stroke -->
    <path
        android:pathData="M38,30 L70,30 L80,78 L28,78 Z"
        android:strokeWidth="1.8"
        android:strokeLineJoin="round"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="38"
                android:startY="30"
                android:endX="80"
                android:endY="78"
                android:type="linear">
                <item android:color="#FFFFFFFF" android:offset="0.0" />
                <item android:color="#FF64D2FF" android:offset="0.35" />
                <item android:color="#FF0A84FF" android:offset="0.70" />
                <item android:color="#FFBF5AF2" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Diagonal Specular Reflection -->
    <path
        android:pathData="M38,30 L50,30 L36,78 L28,78 Z"
        android:fillColor="#14FFFFFF" />

    <!-- Optical Depth Ring (Perspective Circle) -->
    <path
        android:pathData="M54,54 m-15,0 a15,8 0 1,0 30,0 a15,8 0 1,0 -30,0"
        android:strokeColor="#EEFFFFFF"
        android:strokeWidth="1.4" />

    <!-- Secondary Depth Ring -->
    <path
        android:pathData="M54,54 m-10,0 a10,5 0 1,0 20,0 a10,5 0 1,0 -20,0"
        android:strokeColor="#AA64D2FF"
        android:strokeWidth="1.0" />

    <!-- Focal Center Glow Core -->
    <path
        android:pathData="M54,54 m-6,0 a6,3 0 1,0 12,0 a6,3 0 1,0 -12,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="6"
                android:type="radial">
                <item android:color="#FFFFFFFF" android:offset="0.0" />
                <item android:color="#9064D2FF" android:offset="0.6" />
                <item android:color="#000A84FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Optical Dot -->
    <path
        android:pathData="M54,53.5 A1,1 0 1 0 54,54.5 A1,1 0 1 0 54,53.5 Z"
        android:fillColor="#FFFFFFFF" />
</vector>